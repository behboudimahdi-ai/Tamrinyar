generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Workspace {
  id        String   @id
  data      Json
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}
model Clip {
  id      String @id
  content Bytes
  mime    String
}